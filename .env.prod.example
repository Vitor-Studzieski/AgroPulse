# Renomeie para .env.prod. Gere JWT_SECRET com: openssl rand -hex 32
JWT_SECRET=troque-por-64-caracteres-hexadecimais

# String Atlas M0. Use um usuário exclusivo com permissão no banco agropulse.
MONGO_URI=mongodb+srv://usuario:senha@cluster.example.mongodb.net/?retryWrites=true&w=majority

# Dois subdomínios gratuitos, por exemplo DuckDNS, apontando para o IP da VM.
WEB_DOMAIN=agropulse.seu-dominio.example
API_DOMAIN=api.agropulse.seu-dominio.example

# Retenção de telemetria bruta e intervalos modestos para reduzir uso de disco/CPU.
READINGS_TTL_DAYS=30
SIM_INTERVAL_SECONDS=300
ALERT_EVAL_SECONDS=60
ALERT_WEBHOOK_URL=
